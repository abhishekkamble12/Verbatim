# Copy to .env for local development. Never commit real values; prod reads these from SSM.

# Required by the API: "local" trusts the X-User-Id header (dev only), "cognito" validates Bearer tokens.
AUTH_MODE=local

# Postgres. Default is the docker-compose database; change the port if you ran POSTGRES_PORT=5434 make up.
DATABASE_URL=postgresql+psycopg://citeguard:citeguard_dev_password@localhost:5432/citeguard
TEST_DATABASE_URL=postgresql+psycopg://citeguard:citeguard_dev_password@localhost:5432/citeguard
POSTGRES_PORT=5432

# AWS (LocalStack locally). Required for uploads (S3) and jobs (SQS).
AWS_REGION=us-east-1
# Per-service endpoints: a plain AWS_ENDPOINT_URL would also send Bedrock calls to LocalStack.
AWS_ENDPOINT_URL_S3=http://localhost:4566
AWS_ENDPOINT_URL_SQS=http://localhost:4566
S3_BUCKET=citeguard-uploads
SQS_QUEUE_URL=http://localhost:4566/000000000000/citeguard-jobs

# LLM: "bedrock" (AWS credentials) or "groq". Embeddings: Voyage AI if VOYAGE_API_KEY is set, else Bedrock Titan.
# VOYAGE_API_KEY=
LLM_PROVIDER=bedrock
GROQ_API_KEY=
# Optional. Default openai/gpt-oss-20b; see https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-20b
# Optional overrides; confirm Bedrock model IDs for your region.
CITEGUARD_SMALL_MODEL=anthropic.claude-haiku-5-5
CITEGUARD_LARGE_MODEL=anthropic.claude-sonnet-5-5
